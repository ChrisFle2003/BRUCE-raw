{
  "name": "bruce-research-website",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "eleventy --serve",
    "preview": "node scripts/serve.mjs",
    "build": "eleventy",
    "test": "node --test test/*.test.mjs",
    "check": "node scripts/check-site.mjs",
    "test:browser": "playwright test",
    "check:package": "node scripts/check-package.mjs"
  },
  "dependencies": {
    "@11ty/eleventy": "3.1.6",
    "csv-parse": "7.0.3",
    "highlight.js": "11.11.1",
    "markdown-it": "14.3.1",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "linkedom": "0.18.12"
  }
}
