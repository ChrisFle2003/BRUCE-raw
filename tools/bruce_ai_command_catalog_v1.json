{
  "schema": "bruce-ai-command-catalog-v1",
  "entries": [
    {
      "command_id": "calculate", "argv": ["calculate"],
      "synopsis": "Berechne exakt mit ganzen oder rationalen Zahlen: plus, minus, mal, geteilt durch, Rest und Potenz. Begrenzte Rechenaufgaben mit calculate. Berechne modulare Potenzen: Basis hoch Exponent modulo positiver Modulus.",
      "syntax": "calculate --op OP --left NUMBER --right NUMBER [--domain bigint|rational] [--max-bits N] [--modulus N]",
      "side_effect": "compute",
      "arguments": {"type": "object", "additionalProperties": false, "required": ["op", "left", "right"], "properties": {
        "op": {"type": "string", "enum": ["add", "sub", "mul", "div", "divmod", "pow", "modpow"]},
        "left": {"type": "string", "minLength": 1, "maxLength": 16384, "pattern": "^-?[0-9]+(?:/[0-9]+)?$"},
        "right": {"type": "string", "minLength": 1, "maxLength": 16384, "pattern": "^-?[0-9]+(?:/[0-9]+)?$"},
        "domain": {"type": "string", "enum": ["bigint", "rational"]},
        "max_bits": {"type": "integer", "minimum": 1, "maximum": 16384},
        "modulus": {"type": "string", "minLength": 1, "maxLength": 16384, "pattern": "^0*[1-9][0-9]*$"}
      }},
      "sources": ["apps/bruce_cli.cpp", "tests/integration/test_exact_domains.py"]
    },
    {
      "command_id": "coordinate", "argv": ["coordinate"],
      "synopsis": "Z-Ordnung: nichtnegative uint64-Koordinaten x,y paaren oder z entpaaren. Entweder x und y oder ausschließlich z angeben.",
      "syntax": "coordinate --x N --y N | coordinate --z N", "side_effect": "compute",
      "arguments": {"type": "object", "additionalProperties": false, "required": [], "properties": {
        "x": {"type": "string", "minLength": 1, "maxLength": 20, "pattern": "^[0-9]+$"},
        "y": {"type": "string", "minLength": 1, "maxLength": 20, "pattern": "^[0-9]+$"},
        "z": {"type": "string", "minLength": 1, "maxLength": 20, "pattern": "^[0-9]+$"}
      }},
      "sources": ["apps/bruce_cli.cpp", "tests/integration/test_cli.py"]
    },
    {
      "command_id": "grid", "argv": ["grid"],
      "synopsis": "Expliziten Grid-Pfad lokal in exact-, modular- oder metric-Modus auswerten, ohne Export. stage erfordert scaled-exponential-v1, modulus erfordert modular.",
      "syntax": "grid --path X,Y[/X,Y] [--mode MODE] [--rule RULE] [--stage N] [--modulus N] [--max-bits N] [--zero-zero one|stop]", "side_effect": "compute",
      "arguments": {"type": "object", "additionalProperties": false, "required": ["path"], "properties": {
        "path": {"type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^[0-9]+,[0-9]+(?:/[0-9]+,[0-9]+)*$"},
        "mode": {"type": "string", "enum": ["exact", "modular", "metric"]},
        "rule": {"type": "string", "enum": ["leaf-local-power", "scaled-exponential-v1"]},
        "stage": {"type": "integer", "minimum": 0, "maximum": 57},
        "modulus": {"type": "string", "minLength": 1, "maxLength": 20, "pattern": "^0*[1-9][0-9]*$"},
        "max_bits": {"type": "integer", "minimum": 1, "maximum": 64},
        "zero_zero": {"type": "string", "enum": ["one", "stop"]}
      }},
      "sources": ["apps/bruce_cli.cpp", "tests/integration/test_grid_replay.py"]
    },
    {
      "command_id": "grid-batch", "argv": ["grid-batch"],
      "synopsis": "Explizite, durch Semikolon getrennte Grid-Pfade begrenzt auswerten. Optionaler Cache und Query-Grenze; keine Ausgabedatei. stage erfordert scaled-exponential-v1, modulus erfordert modular.",
      "syntax": "grid-batch --paths PATH;PATH [--mode MODE] [--rule RULE] [--stage N] [--modulus N] [--max-bits N] [--zero-zero one|stop] [--cache-bytes N] [--max-query-steps N]", "side_effect": "compute",
      "arguments": {"type": "object", "additionalProperties": false, "required": ["paths"], "properties": {
        "paths": {"type": "string", "minLength": 1, "maxLength": 65536, "pattern": "^[0-9]+,[0-9]+(?:/[0-9]+,[0-9]+)*(?:;[0-9]+,[0-9]+(?:/[0-9]+,[0-9]+)*)*$"},
        "mode": {"type": "string", "enum": ["exact", "modular", "metric"]},
        "rule": {"type": "string", "enum": ["leaf-local-power", "scaled-exponential-v1"]},
        "stage": {"type": "integer", "minimum": 0, "maximum": 57},
        "modulus": {"type": "string", "minLength": 1, "maxLength": 20, "pattern": "^0*[1-9][0-9]*$"},
        "max_bits": {"type": "integer", "minimum": 1, "maximum": 64},
        "zero_zero": {"type": "string", "enum": ["one", "stop"]},
        "cache_bytes": {"type": "integer", "minimum": 0, "maximum": 1048576},
        "max_query_steps": {"type": "integer", "minimum": 0, "maximum": 1024}
      }},
      "sources": ["apps/bruce_cli.cpp", "tests/integration/test_grid_resume.py", "tests/integration/test_grid_cache.py"]
    },
    {
      "command_id": "grid-resume", "argv": ["grid-resume"],
      "synopsis": "Vorhandenes partielles Grid-Batch-Bundle mit expliziter zusätzlicher Query-Grenze lokal fortsetzen; ohne Veröffentlichung einer Datei.",
      "syntax": "grid-resume --from-run PARTIAL --additional-queries N", "side_effect": "compute",
      "arguments": {"type": "object", "additionalProperties": false, "required": ["from_run", "additional_queries"], "properties": {
        "from_run": {"type": "string", "format": "input-file", "minLength": 1, "maxLength": 4096},
        "additional_queries": {"type": "integer", "minimum": 1, "maximum": 1024}
      }},
      "sources": ["apps/bruce_cli.cpp", "tests/integration/test_grid_resume.py"]
    },
    {
      "command_id": "compare", "argv": ["compare"],
      "synopsis": "Rationale Funktionen über Q anhand expliziter Koeffizienten in aufsteigender Reihenfolge vergleichen. Definitionsbereiche und begrenzte Witness-Verfahren bleiben BRUCE maßgeblich.",
      "syntax": "compare --left-numerator COEFFS --left-denominator COEFFS --right-numerator COEFFS --right-denominator COEFFS [--domain-policy POLICY] [--max-bits N] [--max-operations N]", "side_effect": "compute",
      "arguments": {"type": "object", "additionalProperties": false, "required": ["left_numerator", "left_denominator", "right_numerator", "right_denominator"], "properties": {
        "left_numerator": {"type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^-?[0-9]+(?:,-?[0-9]+)*$"},
        "left_denominator": {"type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^-?[0-9]+(?:,-?[0-9]+)*$"},
        "right_numerator": {"type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^-?[0-9]+(?:,-?[0-9]+)*$"},
        "right_denominator": {"type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^-?[0-9]+(?:,-?[0-9]+)*$"},
        "domain_policy": {"type": "string", "enum": ["quadratic", "modular", "modular-witness"]},
        "max_bits": {"type": "integer", "minimum": 1, "maximum": 16384},
        "max_operations": {"type": "integer", "minimum": 1, "maximum": 1000000}
      }},
      "sources": ["apps/bruce_cli.cpp", "tests/integration/test_fraction_compare.py", "tests/integration/test_modular_compare.py"]
    },
    {
      "command_id": "research", "argv": ["research"],
      "synopsis": "Begrenzte affine Forschung auf expliziter Trainings-CSV und optionaler Holdout-CSV. Kandidaten, Operationen, Trace und Resultate begrenzen; keine Datei schreiben und keinen allgemeinen Beweis behaupten. Bei domain bigint ist max_denominator nur 1; bei rational 1 bis 16.",
      "syntax": "research --train FILE [--holdout FILE] [--domain int64|bigint|rational] [--min N] [--max N] [--max-bits N] [--max-denominator N] [--max-candidates N] [--max-operations N] [--max-trace N] [--max-results N] [--max-trace-bytes N]", "side_effect": "compute",
      "arguments": {"type": "object", "additionalProperties": false, "required": ["train"], "properties": {
        "train": {"type": "string", "format": "input-file", "minLength": 1, "maxLength": 4096},
        "holdout": {"type": "string", "format": "input-file", "minLength": 1, "maxLength": 4096},
        "domain": {"type": "string", "enum": ["int64", "bigint", "rational"]},
        "min": {"type": "string", "minLength": 1, "maxLength": 16384, "pattern": "^-?[0-9]+$"},
        "max": {"type": "string", "minLength": 1, "maxLength": 16384, "pattern": "^-?[0-9]+$"},
        "max_bits": {"type": "integer", "minimum": 1, "maximum": 16384},
        "max_denominator": {"type": "integer", "minimum": 1, "maximum": 16},
        "max_candidates": {"type": "integer", "minimum": 1, "maximum": 100000},
        "max_operations": {"type": "integer", "minimum": 1, "maximum": 1000000},
        "max_trace": {"type": "integer", "minimum": 2, "maximum": 100002},
        "max_results": {"type": "integer", "minimum": 1, "maximum": 128},
        "max_trace_bytes": {"type": "integer", "minimum": 256, "maximum": 1048576}
      }},
      "sources": ["apps/bruce_cli.cpp", "tests/integration/test_cli.py", "tests/integration/test_exact_domains.py"]
    },
    {
