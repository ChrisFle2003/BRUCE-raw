  "documentation_prompt_file": "docs/cli/bruce-cli-reference.md",
  "documentation_prompt": "Erstelle eine deutschsprachige, quellengestützte Bedienungsanleitung für die implementierte BRUCE-CLI. Lies apps/bruce_cli.cpp, apps/nanocell_cli.hpp, apps/rule_store.hpp und apps/rule_review.hpp sowie die Ausgabe von bruce --version und bruce --help. Dokumentiere nur implementierte Befehle: pro Befehl Zweck, vollständige Syntax, Positionsargumente, Pflichtoptionen, Defaults, Wertebereiche, Abhängigkeiten, Konflikte, Ausgabe, Export und typische Fehler. Erfinde keine Flags, Kurzoptionen, Konfigurationsdateien oder geplanten Funktionen. Beachte: Optionen haben getrennte Werte; Erfolg ist JSON auf stdout mit Exitcode 0, Fehler JSON auf stderr mit Exitcode 2; Exitcode 0 ist kein mathematischer Beweis; --output überschreibt keine bestehende Datei. Liefere Markdown und valides JSON und prüfe das JSON sowie jeden Befehlsweg gegen Parser und Hilfeausgabe.",
  "global_rules": {
    "option_syntax": "Jede Option benötigt genau einen getrennten Wert; keine Kurzoptionen, kein --name=wert und kein ---Trenner.",
    "case_sensitive": true,
    "duplicate_options": "Fehler",
    "success": {
      "stdout": "JSON",
      "exit_code": 0,
      "not_a_proof": true
    },
    "failure": {
      "stderr": "JSON",
      "exit_code": 2
    },
    "exports": "--output ist optional, erstellt Ziele exklusiv und überschreibt keine vorhandenen Dateien. Zielverzeichnisse werden nicht erzeugt."
  },
